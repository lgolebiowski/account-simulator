{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "permissions": {
    "allow": [
      "Bash(.claude/bin/test.sh*)",
      "Bash(.claude/bin/audit.sh*)",
      "Bash(python3 .claude/hooks/audit-ownership.py*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git worktree list*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.py"],
            "timeout": 40
          }
        ]
      }
    ]
  }
}
